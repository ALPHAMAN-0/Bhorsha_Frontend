# Copy this file to .env and fill in the values. Never commit .env.
# Restart `pnpm dev` after changing .env. NEXT_PUBLIC_ values are built into
# the browser code, so a production build has to be rebuilt after a change.

# Where the NestJS backend runs. Only the Next.js server calls it.
BACKEND_URL=http://localhost:3002

# Google Maps browser key: Google Cloud > APIs & Services > Credentials.
# Restrict it there to http://localhost:3001/* and to Maps JavaScript API,
# Places API (New) and Routes API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Map ID for the pins. DEMO_MAP_ID works while developing.
NEXT_PUBLIC_GOOGLE_MAP_ID=DEMO_MAP_ID
